@model List<Kutuphane.Models.Student>

@{
    Layout = "_AdminLayout";
}


<h1>Öğrenciler</h1>
<a asp-action="AddStudents" class="add-button">
    + Öğrenci Ekle
</a>

<table class="student-table">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Soyad</th>
            <th>Okul No</th>
            <th>Durum</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null)
        {
            foreach (var student in Model)
            {
                <tr>
                    <td>@student.StudentName</td>
                    <td>@student.StudentSurname</td>
                    <td>@student.SchoolNumber</td>
                    <td>@(student.Isactive ? "Aktif" : "Pasif")</td>
                </tr>
            }
        }
    </tbody>
</table>