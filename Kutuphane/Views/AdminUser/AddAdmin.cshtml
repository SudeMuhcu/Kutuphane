@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yönetici Ekle";
}

<div class="book-form">

    <h1>👤 Yönetici Ekle</h1>

    <form asp-action="AddAdmin" method="post">

        <div class="form-group">
            <label>Kullanıcı Adı</label>
            <input name="UserName" class="form-input" />
        </div>

        <div class="form-group">
            <label>Şifre</label>
            <input name="Password"
                   type="password"
                   class="form-input" />
        </div>

        <button type="submit" class="book-button">
            Yönetici Ekle
        </button>

    </form>

</div>