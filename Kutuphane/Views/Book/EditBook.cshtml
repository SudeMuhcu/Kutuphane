@model Kutuphane.Models.Book

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kitap Düzenle";
}

<div class="book-form">

    <h1>📚 Kitap Düzenle</h1>

    <form asp-action="EditBook" method="post">

        <input type="hidden" asp-for="BookId" />

        <div class="form-group">
            <label>Kitap Adı</label>
            <input asp-for="BookName" class="form-input" />
        </div>

        <div class="form-group">
            <label>Kitap Açıklaması</label>
            <textarea asp-for="BookDescription"
                      class="form-input"></textarea>
        </div>

        <div class="form-group">
            <label>Stok</label>
            <input asp-for="BookStock"
                   type="number"
                   min="0"
                   class="form-input" />
        </div>

        <button type="submit" class="book-button">
            Güncelle
        </button>

    </form>

</div>