@model Kutuphane.Models.Book

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kitap Ekle";
}

<div class="book-form">

    <h1>📚 Kitap Ekle</h1>

    <form asp-action="AddBook" method="post">

        <div class="form-group">
            <label>Kitap Adı</label>
            <input asp-for="BookName" class="form-input" />
        </div>

        <div class="form-group">
            <label>Kitap Açıklaması</label>
            <textarea asp-for="BookDescription" class="form-input"></textarea>
        </div>

        <div class="form-group">
            <label>Stok</label>
            <input asp-for="BookStock"
                   type="number"
                   min="0"
                   class="form-input" />
        </div>

        <button type="submit" class="book-button">
            Kitap Ekle
        </button>

    </form>

</div>